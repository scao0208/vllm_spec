ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /home/siyu/miniconda3/envs/vllm-spec/compiler_compat -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/siyu/miniconda3/envs/vllm-spec/include -fPIC -O2 -isystem /home/siyu/miniconda3/envs/vllm-spec/include -fPIC -I/home/siyu/miniconda3/envs/vllm-spec/lib/python3.11/site-packages/flashinfer/data/cutlass/include -I/home/siyu/Documents/vllm_spec_scenario_a/csrc -I/home/siyu/miniconda3/envs/vllm-spec/lib/python3.11/site-packages/torch/include -I/home/siyu/miniconda3/envs/vllm-spec/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/home/siyu/miniconda3/envs/vllm-spec/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=paged_bitmap_attention_ext -std=c++17
cuda_cflags = -I/home/siyu/miniconda3/envs/vllm-spec/lib/python3.11/site-packages/flashinfer/data/cutlass/include -I/home/siyu/Documents/vllm_spec_scenario_a/csrc -I/home/siyu/miniconda3/envs/vllm-spec/lib/python3.11/site-packages/torch/include -I/home/siyu/miniconda3/envs/vllm-spec/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/home/siyu/miniconda3/envs/vllm-spec/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -arch=sm_80 -std=c++17 -O3 --expt-relaxed-constexpr -lineinfo --use_fast_math -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=paged_bitmap_attention_ext
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /home/siyu/Documents/vllm_spec_scenario_a/csrc/build/temp.linux-x86_64-cpython-311/paged_bitmap_attention/launch.o: cuda_compile /home/siyu/Documents/vllm_spec_scenario_a/csrc/paged_bitmap_attention/launch.cu








